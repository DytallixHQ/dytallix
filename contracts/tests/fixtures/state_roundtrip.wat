(module
  (import "env" "storage_set" (func $set (param i32 i32 i32 i32) (result i32)))
  (import "env" "storage_get" (func $get (param i32 i32 i32 i32) (result i32)))
  (import "env" "emit_event" (func $event (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1)
  (data (i32.const 1024) "count")
  (data (i32.const 1032) "42")
  (data (i32.const 1040) "updated")
  (func (export "contract_update") (param i32 i32) (result i32)
    (if (call $set (i32.const 1024) (i32.const 5) (i32.const 1032) (i32.const 2))
      (then unreachable))
    (if (i32.ne
      (call $get (i32.const 1024) (i32.const 5) (i32.const 1056) (i32.const 2))
      (i32.const 2)) (then unreachable))
    (if (i32.ne (i32.load16_u (i32.const 1056)) (i32.const 12852))
      (then unreachable))
    (if (call $event (i32.const 1040) (i32.const 7) (i32.const 1032) (i32.const 2))
      (then unreachable))
    (i32.const 0)))
