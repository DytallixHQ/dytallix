{
  "schema": "dytallix.staging-agent-allowlist.v1",
  "commands": {
    "status": {
      "purpose": "Capture the node's state: unit, operator status, application metrics, disk, memory and clock",
      "args": {},
      "timeout_seconds": 60,
      "steps": [
        ["systemctl", "is-active", "dytallix-node.service"],
        ["{bin}/dytallix-operator-rpc", "--home", "/var/lib/dytallix/node", "status"],
        ["cat", "/var/lib/dytallix/metrics/dytallix-app.prom"],
        ["df", "-B1", "/var/lib/dytallix"],
        ["free", "-b"],
        ["timedatectl", "show", "-p", "NTPSynchronized", "--value"]
      ]
    },
    "journal": {
      "purpose": "The node's newest journal lines",
      "args": {"lines": {"type": "int", "min": 1, "max": 5000}},
      "timeout_seconds": 60,
      "steps": [
        ["journalctl", "-u", "dytallix-node.service", "-o", "cat", "--no-pager", "-n", "{lines}"]
      ]
    },
    "start": {
      "purpose": "Start the node",
      "args": {},
      "timeout_seconds": 120,
      "steps": [
        ["systemctl", "start", "dytallix-node.service"],
        ["systemctl", "is-active", "dytallix-node.service"]
      ]
    },
    "stop": {
      "purpose": "Stop the node",
      "args": {},
      "timeout_seconds": 120,
      "steps": [
        ["systemctl", "stop", "dytallix-node.service"]
      ]
    },
    "monitor-run": {
      "purpose": "Run the monitor job once",
      "args": {},
      "timeout_seconds": 180,
      "steps": [
        ["systemctl", "start", "dytallix-monitor.service"]
      ]
    },
    "backup-run": {
      "purpose": "Run the sentry's backup job once",
      "args": {},
      "timeout_seconds": 900,
      "steps": [
        ["systemctl", "start", "dytallix-backup.service"]
      ]
    },
    "fault-kill": {
      "purpose": "Kill the node's main process (simulation plan, T5: process kill); only the main process, since the supervisor runs its children in their own PID namespace and signalling the whole control group returns EINVAL. The owner protocol brings the children down with it",
      "args": {},
      "timeout_seconds": 60,
      "steps": [
        ["systemctl", "kill", "--kill-whom=main", "--signal=SIGKILL", "dytallix-node.service"]
      ]
    },
    "fault-netem": {
      "purpose": "Latency and loss on the host's interface (simulation plan, T5), removed by its own dead-man timer after duration_seconds",
      "args": {"delay_ms": {"type": "int", "min": 50, "max": 1000}, "loss_percent": {"type": "int", "min": 5, "max": 60}, "duration_seconds": {"type": "int", "min": 10, "max": 300}},
      "timeout_seconds": 60,
      "steps": [
        ["tc", "qdisc", "replace", "dev", "eth0", "root", "netem", "delay", "{delay_ms}ms", "loss", "{loss_percent}%"],
        ["systemd-run", "--on-active={duration_seconds}s", "tc", "qdisc", "del", "dev", "eth0", "root"]
      ]
    },
    "fault-partition": {
      "purpose": "Cut the host off from its peers' p2p port (simulation plan, T5); the drop self-expires after duration_seconds so a console-only host cannot be locked out",
      "args": {"duration_seconds": {"type": "int", "min": 10, "max": 300}},
      "timeout_seconds": 60,
      "steps": [
        ["nft", "add", "table", "inet", "dytallix_fault"],
        ["nft", "add", "set", "inet", "dytallix_fault", "blocked", "{ type inet_service ; flags timeout ; }"],
        ["nft", "add", "chain", "inet", "dytallix_fault", "out", "{ type filter hook output priority 0 ; policy accept ; }"],
        ["nft", "add", "chain", "inet", "dytallix_fault", "in", "{ type filter hook input priority 0 ; policy accept ; }"],
        ["nft", "add", "rule", "inet", "dytallix_fault", "out", "tcp", "dport", "@blocked", "drop"],
        ["nft", "add", "rule", "inet", "dytallix_fault", "out", "tcp", "sport", "@blocked", "drop"],
        ["nft", "add", "rule", "inet", "dytallix_fault", "in", "tcp", "dport", "@blocked", "drop"],
        ["nft", "add", "rule", "inet", "dytallix_fault", "in", "tcp", "sport", "@blocked", "drop"],
        ["nft", "add", "element", "inet", "dytallix_fault", "blocked", "{ 26656 timeout {duration_seconds}s }"]
      ]
    },
    "fault-clear": {
      "purpose": "Remove every injected network fault (simulation plan, T5); idempotent, so it runs whether or not a fault is set",
      "args": {},
      "timeout_seconds": 60,
      "steps": [
        ["tc", "qdisc", "replace", "dev", "eth0", "root", "netem"],
        ["tc", "qdisc", "del", "dev", "eth0", "root"],
        ["nft", "add", "table", "inet", "dytallix_fault"],
        ["nft", "delete", "table", "inet", "dytallix_fault"]
      ]
    }
  }
}
