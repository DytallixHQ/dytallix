[Unit]
Description=Dytallix Fast Node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=dytallix
Group=dytallix
WorkingDirectory=/opt/dytallix-node
Environment=DYT_REQUIRE_EXISTING_VALIDATOR_KEY=1
EnvironmentFile=/etc/dytallix/dytallix-fast-node.env
ExecStartPre=/bin/sh /opt/dytallix-node/deploy/systemd/check-runtime-paths.sh
ExecStart=/opt/dytallix-node/target/release/dytallix-fast-node
Restart=on-failure
RestartSec=5
LimitNOFILE=65535
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
