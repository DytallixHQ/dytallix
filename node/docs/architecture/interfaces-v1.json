{
  "version": 1,
  "document": "node/docs/architecture/interfaces-v1.md",
  "paths_relative_to": "mainnet/",
  "exposure": {
    "external": "Reachable by clients through the engine's RPC or the SDK and CLI.",
    "operator": "Files and outputs an operator's tooling reads on the host.",
    "internal": "Channels between the node's own processes; pinned by the release manifest."
