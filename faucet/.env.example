# Dytallix Testnet Faucet

## Environment Variables
PORT=3001
NODE_ENV=development
CHAIN_ID=dyt-local-1
RPC_ENDPOINT=http://127.0.0.1:3030

# Faucet Configuration
DGT_FAUCET_AMOUNT=10000000udgt
DRT_FAUCET_AMOUNT=100000000udrt
FAUCET_PRIVATE_KEY=replace_with_testnet_only_private_key
FAUCET_ADDRESS=dyt1replacewithtestnetonlyfaucetaddress
FAUCET_MNEMONIC=replace_with_testnet_only_mnemonic

# Rate Limiting
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_REQUESTS=20
IP_COOLDOWN_MS=60000

# Redis Configuration (Optional - for distributed rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
API_KEY_REQUIRED=false
API_KEY=replace_with_nonproduction_api_key

# Logging
LOG_LEVEL=info
LOG_FILE=logs/faucet.log