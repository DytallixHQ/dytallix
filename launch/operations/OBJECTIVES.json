{
  "schema": "dytallix.operations-objectives.v1",
  "approval_record": "approvals/P01_E05_OPERATIONS_OBJECTIVES_2026-10-03.json",
  "service_targets": {
    "period": "calendar month",
    "measured_by": "the independent monitor",
    "excluded": "planned upgrades",
    "chain": {
      "rule": "a block committed in the minute",
      "target_percent": 99.9
    },
    "endpoints": {
      "rule": "at least one client endpoint serves state within max_head_lag_blocks of the head",
      "max_head_lag_blocks": 3,
      "target_percent": 99.5
    }
  },
  "on_call": {
    "coverage": "24/7",
    "min_rotation_people": 2,
    "escalation_contact_required": true,
    "severities": [
      {
        "severity": 1,
        "examples": [
          "chain halted",
          "a validator at double-sign risk",
          "a key compromise",
          "monitoring down"
        ],
        "pages": "24/7",
        "acknowledge_minutes": 15,
        "console_minutes": 30
      },
      {
        "severity": 2,
        "respond_hours": 4
      },
      {
        "severity": 3,
        "respond": "next business day"
      }
    ]
  },
  "retention": {
    "chain_history": {
      "archive_nodes_min": 2,
      "archive_nodes_distinct_operators": true,
      "archive_nodes_distinct_providers": true,
      "offline_export": "monthly",
      "other_nodes": "the approved retained window (E05 block_history)"
    },
    "logs_days": 90,
    "logs_redacted": true,
    "metrics_months": 13,
    "incident_alert_audit_records": "permanent"
  },
  "backup": {
    "snapshots": "the approved daily snapshots (E05 snapshot_interval_blocks, snapshot_keep)",
    "off_host_copy": "a second provider",
    "encryption": "AES-256",
    "keys": "custody only, never in routine backups",
    "signing_state": "never restored from a backup; a replacement signs only after the old host is fenced off"
  },
  "recovery": {
    "rpo_committed_blocks": 0,
    "rto_minutes": {
      "validator": 480,
      "sentry": 240,
      "endpoint_service": 15,
      "monitoring": 60
    },
    "validator_rto_basis": {
      "provision_minutes": 120,
      "catch_up": "the approved catch_up_millis (6 hours)"
    },
    "restore_drills": "quarterly, on staging"
  }
}
